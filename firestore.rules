rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Visiteur de l'application (connexion anonyme ou administrateur).
    function signedIn() {
      return request.auth != null;
    }

    // Administrateur : compte e-mail dont l'UID figure dans la collection « admins ».
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Membre connecté : compte relié à un prénom par l'administrateur (collection « accounts »).
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function myUserId() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.userId;
    }

    function task(id) {
      return get(/databases/$(database)/documents/tasks/$(id)).data;
    }

    // Liste des administrateurs : modifiable uniquement depuis la console Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Lien compte de connexion → membre du foyer : géré par l'administrateur.
    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Demandes d'inscription : chacun crée la sienne (compte e-mail), l'administrateur la valide.
    match /signups/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if false;
    }

    match /users/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Tâches : seul l'administrateur crée, supprime et fixe les points.
    // Les membres peuvent seulement marquer comme faite (ou non faite) une tâche qui leur est
    // attribuée (ou attribuée à tout le monde).
    match /tasks/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isMember()
            && resource.data.get('assigneeId', null) in [null, myUserId()]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'dueAt', 'reminded', 'lastCompletionId'])
            // remettre une tâche « à faire » exige d'annuler sa validation en même temps
            && (resource.data.get('done', false) == false
                || request.resource.data.get('done', false) == true
                || !existsAfter(/databases/$(database)/documents/completions/$(resource.data.get('lastCompletionId', 'aucune')))));
    }

    // Points gagnés : chacun ne valide que ses propres tâches, pour lui-même ou pour les
    // personnes qui l'ont aidé (tâche partagée, champ « by »), et les points sont ceux de la tâche.
    // Les tâches bonus (sans tâche associée) ne peuvent être créditées que par l'administrateur.
    match /completions/{id} {
      allow read: if signedIn();
      allow create: if (isAdmin() && request.resource.data.get('bonus', false) == true)
        || (isMember()
            && request.resource.data.keys().hasOnly(['taskId', 'title', 'userId', 'points', 'at', 'prevDueAt', 'groupId', 'by'])
            && ((request.resource.data.userId == myUserId() && !('by' in request.resource.data))
                || (request.resource.data.get('by', '') == myUserId()
                    && request.resource.data.userId != myUserId()
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))))
            && request.resource.data.taskId is string
            && task(request.resource.data.taskId).get('assigneeId', null) in [null, myUserId()]
            && task(request.resource.data.taskId).points == request.resource.data.points
            && task(request.resource.data.taskId).get('done', false) == false
            // une tâche non répétée doit être marquée faite en même temps (pas de double validation)
            && (task(request.resource.data.taskId).get('recurrence', 'none') != 'none'
                || (getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.get('done', false) == true
                    && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.get('lastCompletionId', '') == request.resource.data.get('groupId', id))));
      allow update: if isAdmin();
      // Annulation (erreur) : par la personne concernée, par celle qui a enregistré la tâche partagée,
      // ou par l'administrateur (bonus compris).
      allow delete: if isAdmin()
        || (isMember() && resource.data.get('bonus', false) == false
            && (resource.data.userId == myUserId() || resource.data.get('by', '') == myUserId()));
    }

    // Propositions de tâches et tâches bonus : tout le monde propose, l'administrateur valide.
    match /suggestions/{id} {
      allow create: if isMember() && request.resource.data.proposedBy == myUserId();
      allow read, update, delete: if isAdmin();
    }

    match /bonuses/{id} {
      allow create: if isMember() && request.resource.data.userId == myUserId();
      allow read, update, delete: if isAdmin();
    }

    // Paliers de récompense en euros.
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Jetons de notification des téléphones.
    match /tokens/{token} {
      allow read, write: if signedIn();
    }
  }
}
